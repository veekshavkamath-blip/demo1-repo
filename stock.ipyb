    {
      "cell_type": "code",
      "source": [
        "feat_cols = [c for c in train_df.columns if c not in ['close', 'date', 'symbols']]\n",
        "\n",
        "Xtr = train_df[feat_cols]\n",
        "Xte = test_df[feat_cols]\n",
        "means = Xtr.mean()\n",
        "Xtr = Xtr.fillna(means).values\n",
        "Xte = Xte.fillna(means).values\n",
        "\n",
        "mu, sigma = Xtr.mean(axis=0), Xtr.std(axis=0)\n",
        "Xtr = (Xtr - mu) / sigma\n",
        "Xte = (Xte - mu) / sigma\n",
        "\n",
        "X_train = np.c_[np.ones(len(Xtr)), Xtr]\n",
        "X_test = np.c_[np.ones(len(Xte)), Xte]\n",
        "y_train = train_df['close'].values\n",
        "y_test = test_df['close'].values\n",
        "\n",
        "w = np.zeros(X_train.shape[1])\n",
        "lr, epochs = 0.1, 200\n",
        "costs = []\n",
        "\n",
        "for ep in range(1, epochs + 1):\n",
        "    grad = X_train.T @ (predict(X_train, w) - y_train) / len(y_train)\n",
        "    w = w - lr * grad\n",
        "    c = cost(X_train, y_train, w)\n",
        "    costs.append(c)\n",
        "    tr = r2(y_train, predict(X_train, w))\n",
        "    te = r2(y_test, predict(X_test, w))\n",
        "    print(f\"Epoch {ep}/{epochs} | Cost: {c:.4f} | Train acc: {tr:.2f}% | Test acc: {te:.2f}%\")\n",
        "\n",
        "plt.plot(costs)\n",
        "plt.xlabel('Epoch')\n",
        "plt.ylabel('Cost')\n",
        "plt.title('Cost vs Epochs')\n",
        "plt.show()"
      ],
