      "source": [
        "print(list(train_df.columns) == list(test_df.columns))\n",
        "print(y_train.mean(), y_train.std(), y_test.mean(), y_test.std())\n",
        "print(np.abs(X_train[:,1:]).max(axis=0).round(1))\n",
        "print(np.abs(X_test[:,1:]).max(axis=0).round(1))"
