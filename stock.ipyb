    {
      "cell_type": "code",
      "source": [
        "train_df = train_df.dropna(subset=['close'])\n",
        "test_df = test_df.dropna(subset=['close'])\n",
        "\n",
        "drop_cols = ['close', 'date', 'symbols']\n",
        "y_train = train_df['close'].values\n",
        "y_test = test_df['close'].values\n",
        "X_train = train_df.drop(columns=drop_cols)\n",
        "X_test = test_df.drop(columns=drop_cols)\n",
        "\n",
        "means = X_train.mean()\n",
        "X_train = X_train.fillna(means).values\n",
        "X_test = X_test.fillna(means).values"
      ],
      "metadata": {
        "id": "ppo0THKXbPtA"
      },
      "execution_count": 11,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "mu = X_train.mean(axis=0)\n",
        "sigma = X_train.std(axis=0)\n",
        "X_train = (X_train - mu) / sigma\n",
        "X_test = (X_test - mu) / sigma\n",
        "\n",
        "X_train = np.c_[np.ones(len(X_train)), X_train]\n",
        "X_test = np.c_[np.ones(len(X_test)), X_test]\n",
        "\n",
        "print(X_train.shape, X_test.shape)"
      ],
      "metadata": {
        "id": "OWzoJhfueQBL",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "7cf70205-944c-4136-a05b-92e5afef276a"
      },
      "execution_count": 12,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "(106517, 17) (106135, 17)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def predict(X, w):\n",
        "    return X @ w\n",
        "\n",
        "def cost(X, y, w):\n",
        "    e = predict(X, w) - y\n",
        "    return (e @ e) / (2 * len(y))\n",
        "\n",
        "def r2(y, y_hat):\n",
        "    return (1 - np.sum((y - y_hat)**2) / np.sum((y - y.mean())**2)) * 100\n",
        "\n",
        "w = np.zeros(X_train.shape[1])\n",
        "lr = 0.1\n",
        "epochs = 200\n",
        "costs = []\n",
        "\n",
        "for ep in range(1, epochs + 1):\n",
        "    grad = X_train.T @ (predict(X_train, w) - y_train) / len(y_train)\n",
        "    w = w - lr * grad\n",
        "\n",
        "    c = cost(X_train, y_train, w)\n",
        "    costs.append(c)\n",
        "    tr = r2(y_train, predict(X_train, w))\n",
        "    te = r2(y_test, predict(X_test, w))\n",
        "    print(f\"Epoch {ep}/{epochs} | Cost: {c:.4f} | Train acc: {tr:.2f}% | Test acc: {te:.2f}%\")\n",
        "\n",
        "plt.plot(costs)\n",
        "plt.xlabel('Epoch')\n",
        "plt.ylabel('Cost')\n",
        "plt.title('Cost vs Epochs')\n",
        "plt.show()"
      ],
      "metadata": {
        "id": "D2-YZaYofhGM",
        "colab": {
          "base_uri": "https://localhost:8080/",
